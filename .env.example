# Work With Me form storage.
#
# Read by src/lib/supabase/server.js inside the /api/work-inquiries route
# handler. Neither has a NEXT_PUBLIC_ prefix, so Next.js will not inline them
# into the browser bundle — do not add one.
#
# The publishable key is intentionally used instead of the service role key:
# the work_inquiries table allows INSERT only and has no SELECT policy, so this
# key can add an enquiry but cannot read any back. Find both values in the
# Supabase dashboard under Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Email notifications (Contact form + Work With Me form), sent via Resend.
# Create a key at https://resend.com/api-keys. Server-only, no NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Inbox that receives the messages (defaults to personalInfo.email).
CONTACT_TO_EMAIL=you@example.com
# Optional. Without a verified domain, leave this unset: the default
# onboarding@resend.dev sender only delivers to your own Resend account email.
# RESEND_FROM=Portfolio <hello@yourdomain.com>

# Local development: copy to .env.local (already gitignored) and fill in.
# On Vercel: add both under Project Settings -> Environment Variables.
